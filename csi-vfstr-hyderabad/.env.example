# ==============================================================================
# CSI VFSTR HYDERABAD - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or set these environment variables in your cloud provider
# ==============================================================================

# Port to listen on (automatically set by Render, Railway, Heroku, etc.)
PORT=5000

# Environment mode ('production' or 'development')
NODE_ENV=production

# Strong secret key for signing JWT authentication tokens (REQUIRED)
# Generate a random 64-character string for production
JWT_SECRET=replace_with_a_very_long_secure_random_jwt_secret_key_2026

# Initial password for the 'admin' account (REQUIRED on first run)
ADMIN_PASSWORD=csi@vfstr2026

# Permitted CORS origins (optional in production since frontend is served from same host)
# Example: https://csi-vfstr.onrender.com,https://csivfstr.org
CLIENT_URL=

# Optional MongoDB Atlas Connection String
# If omitted, the server uses the built-in persistent atomic JSON store in server/data/db.json
# Example: mongodb+srv://csiadmin:<password>@cluster0.mongodb.net/csi_db?retryWrites=true&w=majority
# MONGODB_URI=
